# Copy to .env and fill in. .env is git-ignored.

# --- Firmware build (build.sh) ---------------------------------------------------------------
# edk2-rk3588 checkout (https://github.com/edk2-porting/edk2-rk3588, submodules initialised,
# including edk2/MdePkg/Library/BaseFdtLib/libfdt)
UPSTREAM=
# UniXNU checkout (provides package/UniXNUPkg and drivers/DarwinBoot)
UNIXNU=
# clang 20 bin directory with a trailing slash (edk2 CLANGDWARF toolchain)
CLANG_BIN=

# --- Shared board tools -----------------------------------------------------------------------
# UniXNU-rk3588-common checkout (tools/board has the serial capture and the USB helpers).
# Default: ../UniXNU-rk3588-common
#RK3588_COMMON=

# --- Board host (the machine the board is physically connected to) ----------------------------
# ssh target, e.g. user@host; key authentication is expected, never put a password in this file
#BOARD_HOST=
# serial device of the console on that machine; the USB adapter comes back under another name when the board resets, so use its by-id path
#BOARD_SERIAL_DEV=/dev/serial/by-id/usb-...

# iasl (ACPICA) is needed for the DSDT; put it on PATH here if it is not installed system-wide, e.g.
#PATH=/path/to/acpica/generate/unix/bin:$PATH

# --- Bundle for the board (tools/board/make-bundle.sh) ----------------------------------------
# UniXNU-orangepi5 checkout
#DEVICE_DIR=
# Directory with trust/original-static-system.bundle and data/owner-data-2048.trim.img (the seeds of the owner image)
#ARTIFACTS=
# userdata-root.img of `unixnu build userdata` (the OS and SystemOS windows of the 17.7.11 restore image; board independent)
#ROOT_IMAGE=
# UniqueChipID the payload's device tree carries (the one the Data seed was made for)
#UNIQUE_CHIP_ID=
# Command prefix the UniXNU build needs (a user-namespace wrapper on a machine without root); empty otherwise
#UNIXNU_WRAP=
# Directory of mtools (mtype, mcopy), if not on PATH
#MTOOLS_BIN=
# Parallel jobs
#JOBS=8
